{
  "name": "@contract-obligation-tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "tsx src/jobs/worker-entry.ts",
    "scheduler": "tsx src/jobs/scheduler-entry.ts",
    "migrate:workflow": "tsx src/scripts/apply-workflow-migrations.ts",
    "check:anchor-boxes": "tsx src/scripts/check-anchor-boxes.ts",
    "check:connections": "tsx src/scripts/check-connections.ts",
    "enqueue:pending-contracts": "tsx src/scripts/enqueue-pending-contract-processing.ts",
    "process:queued-contracts": "tsx src/scripts/process-queued-contract-jobs.ts",
    "reprocess:obligations": "tsx src/scripts/reprocess-contract-obligations.ts",
    "requeue:failed-obligation-reprocess": "tsx src/scripts/requeue-failed-obligation-reprocess.ts",
    "summarize:obligation-reprocess": "tsx src/scripts/summarize-obligation-reprocess.ts",
    "import:cuad-subset": "tsx src/scripts/import-cuad-subset.ts",
    "reset:dev-data": "tsx src/scripts/reset-dev-data.ts",
    "email:doctor": "tsx src/scripts/email-doctor.ts",
    "email:smoke": "tsx src/scripts/smoke-reminder-email.ts",
    "gemini:doctor": "tsx src/scripts/gemini-doctor.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:workflow:dist": "node dist/src/scripts/apply-workflow-migrations.js",
    "start:render": "node dist/src/scripts/apply-workflow-migrations.js && node dist/src/server.js",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:kpi": "vitest run tests/kpi --passWithNoTests"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@napi-rs/canvas": "^1.0.2",
    "@supabase/supabase-js": "^2.110.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1"
  }
