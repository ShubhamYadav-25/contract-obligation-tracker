# Copy this file to .env for local development.
# Never commit real passwords, API keys, JWT secrets, SMTP credentials, or service-role keys.

# Application
NODE_ENV=development
APP_NAME=Contract Obligation Tracker
APP_BASE_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000002

# Backend
API_HOST=0.0.0.0
# Render sets PORT automatically; API_PORT wins locally when set.
PORT=
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
CONTRACT_MAX_FILE_SIZE_MB=20
CONTRACT_MAX_PAGE_COUNT=300
CUAD_IMPORT_CONCURRENCY=2
INGESTION_DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
INGESTION_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000002

# PostgreSQL - Supabase shared pooler connection string
# Percent-encode special characters in the password before placing it in DATABASE_URL.
DATABASE_URL=postgresql://postgres.project-ref:replace-me@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Storage - Supabase private bucket
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=contract_obligation_tracker_bucket

# Obligation extraction
# reference-aware-gemini uses Gemini first. When GROQ_API_KEY is also configured,
# quota and request-budget exhaustion trigger Groq, which retains its heuristic fallback.
OBLIGATION_EXTRACTOR_MODE=reference-aware-gemini

# Groq
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
GROQ_EXTRACTION_TEMPERATURE=0.1
GROQ_EXTRACTION_MAX_TOKENS=2048
GROQ_EXTRACTION_TIMEOUT_MS=45000
GROQ_EXTRACTION_MAX_ATTEMPTS=3
GROQ_EXTRACTION_RETRY_BASE_DELAY_MS=1000
GROQ_EXTRACTION_RETRY_MAX_DELAY_MS=10000

# Gemini structured LLM
GEMINI_API_KEY=<local-secret>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=300000
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_REQUESTS_PER_CONTRACT=8
GEMINI_MIN_REQUEST_INTERVAL_MS=15000
GEMINI_MAX_QUOTA_RETRIES=4
GEMINI_MAX_RETRY_DELAY_MS=120000
GEMINI_MAX_WINDOWS_PER_BATCH=4
GEMINI_MAX_BATCH_INPUT_CHARACTERS=18000
GEMINI_MAX_BATCH_OUTPUT_TOKENS=6000

# OCR
OCR_PROVIDER=tesseract
TESSERACT_WORKER_COUNT=1
DOCUMENT_TEXT_MIN_CHARACTERS=25
DOCUMENT_TEXT_MIN_WORDS=5
DOCUMENT_TEXT_MIN_PRINTABLE_RATIO=0.75
DOCUMENT_TEXT_MAX_ISOLATED_TOKEN_RATIO=0.45
DOCUMENT_SEGMENT_MAX_CHARACTERS=1200
DOCUMENT_SEGMENT_LINE_OVERLAP=0
OCR_TIMEOUT_MS=30000
OCR_MIN_CONFIDENCE=40
OCR_RENDER_SCALE=2
GEMINI_OCR_FALLBACK_ENABLED=false

# Email
EMAIL_PROVIDER=brevo
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Contract Obligation Tracker
REMINDER_RECIPIENT_EMAIL=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=contract-obligation-tracker
JWT_AUDIENCE=contract-obligation-tracker
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# PostgreSQL Jobs
JOB_POLL_INTERVAL_MS=2000
JOB_BATCH_SIZE=5
JOB_LOCK_DURATION_MS=300000
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY_MS=30000
JOB_RETRY_MAX_DELAY_MS=1800000
WORKER_ID=local-worker

# Scheduler
REMINDER_CRON_TIMEZONE=UTC
SCHEDULER_CRON=*/5 * * * *
REMINDER_LOOKAHEAD_MINUTES=15

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
